# ============================================================
# ZN-M2 Network Configuration
# Dual-line dialing: WAN (broadband) + IPTV (separate port)
# ============================================================
# Physical ports (from DTS):
#   wan  - Broadband PPPoE (dp5)
#   lan1 - IPTV PPPoE (dp4, independent, routing table 100)
#   lan2 - LAN bridge member (dp2)
#   lan3 - LAN bridge member (dp1)
# NOTE: ZN-M2 has only 3 LAN + 1 WAN = 4 ports total
# ============================================================

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd00::/48'

# --- LAN Bridge ---
config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan2'
	list ports 'lan3'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '60'

# --- WAN: Broadband PPPoE ---
config interface 'wan'
	option device 'wan'
	option proto 'pppoe'
	option username '13812345678@139.gd'
	option password '123456'
	option ipv6 'auto'
	option norelease '1'
	option metric '10'
	option multipath 'off'

# --- IPTV: Independent PPPoE on lan1 ---
config interface 'IPTV'
	option proto 'pppoe'
	option device 'lan1'
	option username 'jmITV12345678@iptv.gd'
	option password '12345678'
	option ipv6 'auto'
	option norelease '1'
	option multipath 'off'
	option ip4table '100'
	option sourcefilter '0'
	option delegate '0'
	option metric '20'
	option dns_metric '20'

# --- IPTV Static Routes (routing table 100) ---
# Auth / VOD servers
config route
	option interface 'IPTV'
	option target '183.59.0.0/16'
	option table '100'
	option metric '5'

config route
	option interface 'IPTV'
	option target '125.88.0.0/16'
	option table '100'
	option metric '5'

config route
	option interface 'IPTV'
	option target '59.37.0.0/16'
	option table '100'
	option metric '5'

config route
	option interface 'IPTV'
	option target '202.105.0.0/16'
	option table '100'
	option metric '5'

# Multicast / live TV
config route
	option interface 'IPTV'
	option target '239.77.0.0/16'
	option table '100'
	option metric '5'

# Internal network
config route
	option interface 'IPTV'
	option target '10.0.0.0/8'
	option table '100'
	option metric '5'

# --- IPV4 Rules: Route IPTV traffic via table 100 ---
config rule
	option dest '59.37.0.0/16'
	option lookup '100'
	option priority '100'

config rule
	option dest '125.88.0.0/16'
	option lookup '100'
	option priority '100'

config rule
	option dest '202.105.0.0/16'
	option lookup '100'
	option priority '100'

config rule
	option dest '183.59.0.0/16'
	option lookup '100'
	option priority '100'

config rule
	option dest '239.77.0.0/16'
	option lookup '100'
	option priority '100'

config rule
	option dest '10.0.0.0/8'
	option lookup '100'
	option priority '100'
