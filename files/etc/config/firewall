# ============================================================
# ZN-M2 Firewall Configuration
# Dual-line: LAN <-> WAN, LAN <-> IPTV bidirectional
# ============================================================

# --- Defaults ---
config defaults
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option synflood_protect '1'

# --- LAN Zone ---
config zone
	option name 'lan'
	list network 'lan'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'

# --- WAN Zone (broadband) ---
config zone
	option name 'wan'
	list network 'wan'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'

# --- IPTV Zone ---
config zone
	option name 'iptv'
	list network 'IPTV'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option masq '1'

# --- Forwarding: LAN <-> WAN ---
config forwarding
	option src 'lan'
	option dest 'wan'

# --- Forwarding: LAN <-> IPTV ---
config forwarding
	option src 'lan'
	option dest 'iptv'

config forwarding
	option src 'iptv'
	option dest 'lan'

# --- Rules: IPTV -> LAN ---
config rule
	option name 'iptv-to-lan'
	option src 'iptv'
	option dest 'lan'
	option family 'ipv4'
	option target 'ACCEPT'

# --- IPTV NAT Masquerade ---
config nat
	option name 'iptv-nat-1'
	option family 'ipv4'
	option src 'iptv'
	option dest_ip '125.88.52.199'
	option target 'MASQUERADE'
	list proto 'all'

config nat
	option name 'iptv-nat-2'
	option family 'ipv4'
	option src 'iptv'
	option src_ip '192.168.0.100'
	option dest_ip '125.88.104.40'
	option target 'MASQUERADE'
	list proto 'all'

config nat
	option name 'iptv-nat-3'
	option family 'ipv4'
	option src 'iptv'
	option src_ip '192.168.0.100'
	option dest_ip '125.88.70.140'
	option target 'MASQUERADE'
	list proto 'all'

