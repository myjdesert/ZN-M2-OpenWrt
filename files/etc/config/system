# ============================================================
# System configuration for ZN-M2
# ============================================================

config system
    option hostname 'ZN-M2'
    option timezone 'CST-8'
    option zonename 'Asia/Shanghai'
    option ttylogin '0'
    option log_size '64'
    option urandom_seed '0'

config timeserver 'ntp'
    option enabled '1'
    option enable_server '0'
    list server 'ntp.aliyun.com'
    list server 'time1.cloud.tencent.com'
    list server 'cn.pool.ntp.org'
    list server 'time.windows.com'

# --- RSSI / LED config ---
config led
    option name 'WAN'
    option sysfs 'green:wan'
    option trigger 'netdev'
    option dev 'wan'
    option mode 'link up'

config led
    option name 'WLAN2G'
    option sysfs 'green:wlan2g'
    option trigger 'phy0tpt'

config led
    option name 'WLAN5G'
    option sysfs 'green:wlan5g'
    option trigger 'phy1tpt'
