# Force LF line endings for shell scripts and configs (GitHub Actions runs on Linux)
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.config text eol=lf
*.custom text eol=lf

# Extensionless files are NOT matched by the globs above but are still consumed by
# busybox sh on the router — a stray CR there breaks them at runtime.
files/etc/crontabs/root text eol=lf
files/etc/hotplug.d/iface/* text eol=lf
files/etc/uci-defaults/* text eol=lf
files/etc/iptv/* text eol=lf
files/etc/config/* text eol=lf

# UPnP firewall-reload hook - executed by fw4 as a script, a stray CR breaks it
files/etc/upnp-fw-hook.sh text eol=lf

# Ignore binary and build artifacts
*.bin binary
*.ubi binary
*.ipk binary
*.apk binary
