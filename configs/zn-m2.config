# ============================================================
# ZN-M2 OpenWrt Build Configuration
# Target: Qualcomm IPQ6000 (qualcommax/ipq60xx/zn_m2)
# Source: VIKINGYFY/ImmortalWrt main (NSS Full Support)
# Kernel: 6.18 with full NSS stack (nss-drv + ecm + nss-dp + ssdk + firmware)
# Features: PASSWALL (Xray+sing-box) + rtp2httpd + 集客AC + IPTV dual-line
# Memory: 1GB RAM, 128MB NAND (~94MB usable)
# ============================================================

# --- Target ---
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_zn_m2=y

# --- Kernel options ---
# 6.18 from VIKINGYFY/ImmortalWrt main (NSS full support)
CONFIG_KERNEL_ZRAM=y
CONFIG_KERNEL_ZRAM_WRITEBACK=y
CONFIG_KERNEL_ZRAM_MEMORY_LIMIT=256
CONFIG_KERNEL_SWAP=y
CONFIG_KERNEL_CGROUPS=y

# --- Filesystem ---
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
# CONFIG_TARGET_ROOTFS_EXT4 is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set
# CONFIG_TARGET_ROOTFS_JFFS2 is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set

# --- Image options ---
CONFIG_TARGET_ROOTFS_PARTSIZE=80

# --- Base system ---
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_kernel=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_ubox=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y
CONFIG_PACKAGE_usign=y

# --- IPv6 ---
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# --- LuCI Web Interface ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y

# Argon theme (modern, popular for IPQ devices)
CONFIG_PACKAGE_luci-theme-argon=y
# Argon theme configuration app (login background, header, etc.)
CONFIG_PACKAGE_luci-app-argon-config=y
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
# CONFIG_PACKAGE_luci-theme-design is not set

# --- Chinese (Simplified) ---
# CRITICAL: current LuCI gates every luci-i18n-*-zh-cn package behind a
# CONFIG_LUCI_LANG_* switch (see feeds/luci/luci.mk: DEFAULT:=LUCI_LANG_$(lang)).
# Without CONFIG_LUCI_LANG_zh_Hans=y those packages do not exist and
# `make defconfig` silently drops them -> English-only UI.
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-gecoosac-zh-cn=y
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# LuCI applications - system
# NOTE on names in this source tree (immortalwrt/luci, OpenWrt 24.10+ layout):
#   luci-app-opkg  -> luci-app-package-manager   (renamed)
#   luci-app-system / luci-app-network          (do not exist, use the mods)
#   luci-app-turboacc                           (does not exist here)
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y

# --- PASSWALL ---
# Proxy toolchain for OpenWrt
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_passwall=y
CONFIG_PACKAGE_passwall-core=y

# Proxy cores - Xray-core + sing-box
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y

# Passwall dependencies
CONFIG_PACKAGE_v2ray-geodata=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-domain-list-community=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_tcping=y

# --- rtp2httpd ---
# IPTV multicast to unicast HTTP stream converter
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y

# --- 集客AC (gecoosac) ---
# Wireless AP controller (manages Jike APs, aarch64 pre-built binary)
CONFIG_PACKAGE_gecoosac=y
CONFIG_PACKAGE_luci-app-gecoosac=y
CONFIG_PACKAGE_luci-i18n-gecoosac-zh-cn=y
CONFIG_PACKAGE_openssl-util=y

# --- IPTV / Multicast ---
# igmpproxy not needed for dual-line setup (IPTV has direct WAN access)
# CONFIG_PACKAGE_igmpproxy is not set
# CONFIG_PACKAGE_multicast-relay is not set

# --- Network tools ---
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-nf-iptables=y
CONFIG_PACKAGE_kmod-nft-compat=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y

# Multicast / IGMP kernel modules
CONFIG_PACKAGE_kmod-ipt-igmp=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y

# VLAN support
CONFIG_PACKAGE_kmod-8021q=y
# CONFIG_PACKAGE_kmod-gpio-nxp-74hc164 is not set

# Bridge / network
CONFIG_PACKAGE_kmod-bridge=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# PPPoE (dual-line dialing)
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y

# --- WiFi ---
# DISABLED: Not needed, save ~15MB NAND space
# VIKINGYFY main has kmod-ath11k-ahb and wpad-openssl in DEFAULT_PACKAGES
# diy-part2.sh removes them from DEFAULT_PACKAGES, but also disable here for safety
# CONFIG_PACKAGE_kmod-ath is not set
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath11k-ahb is not set
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_ath11k-firmware-ipq6018 is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_wireless-regdb is not set

# --- Utilities ---
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_coreutils-stat=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_block-mount=y

# --- DDNS: DISABLED (not needed) ---
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_ddns-scripts is not set
# CONFIG_PACKAGE_ddns-scripts_cloudflare.com-v4 is not set
# CONFIG_PACKAGE_ddns-scripts_freedns_42_pl is not set
# CONFIG_PACKAGE_ddns-scripts_godaddy_com-v1 is not set
# CONFIG_PACKAGE_ddns-scripts_no-ip_com is not set

# --- Disable heavy packages to save NAND space ---
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-frpc is not set
# CONFIG_PACKAGE_luci-app-frps is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_luci-app-qbittorrent is not set
# CONFIG_PACKAGE_luci-app-transmission is not set
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_luci-app-nfs is not set
# CONFIG_PACKAGE_luci-app-nginx is not set
# CONFIG_PACKAGE_luci-app-nginx-pingos is not set
# CONFIG_PACKAGE_luci-app-ipsec-vpnd is not set
# CONFIG_PACKAGE_luci-app-ocserv is not set
# CONFIG_PACKAGE_luci-app-pptp-server is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-autoreboot is not set
# CONFIG_PACKAGE_luci-app-cpufreq is not set
# CONFIG_PACKAGE_luci-app-filetransfer is not set
# CONFIG_PACKAGE_luci-app-istore is not set
# CONFIG_PACKAGE_luci-app-istorex is not set
# CONFIG_PACKAGE_luci-app-diskman is not set

# --- USB (disabled to save space, enable if needed) ---
# CONFIG_PACKAGE_kmod-usb2 is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-usb-storage-extras is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-vfat is not set
# CONFIG_PACKAGE_e2fsprogs is not set
# CONFIG_PACKAGE_kmod-nls-cp437 is not set
# CONFIG_PACKAGE_kmod-nls-iso8859-1 is not set

# --- SSL ---
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_libopenssl=y

# --- NSS / Hardware acceleration ---
# VIKINGYFY/ImmortalWrt main puts the FULL NSS stack into DEFAULT_PACKAGES of
# target/linux/qualcommax/Makefile, so it is enabled automatically:
#   kmod-qca-nss-drv (core, pulls nss-firmware) + all kmod-qca-nss-drv-* submodules
#   kmod-qca-nss-ecm (ECM connection manager = the actual offload engine)
#   kmod-qca-nss-dp (data plane ethernet driver, one netdev per port)
#   kmod-qca-ssdk (switch SDK), kmod-qca-nss-crypto
# They are listed here explicitly as well for clarity / verification.
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-ssdk=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_nss-firmware=y

# NSS driver submodules (PPPoE is required: this firmware uses dual PPPoE lines)
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-match=y
CONFIG_PACKAGE_kmod-qca-nss-drv-mirror=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-gre=y

# Port status: each dp port is an independent netdev labelled in the DTS
# (dp4=lan1, dp2=lan2, dp1=lan3, dp5=wan), so LuCI shows all 4 ports.

# ECM (the NSS connection manager) is installed and started by default via
# /etc/init.d/qca-nss-ecm. luci-app-turboacc does not exist in this source
# tree, so there is no LuCI switch for it - it is on out of the box.
CONFIG_PACKAGE_kmod-nf-conntrack-extra=y

# --- Full Cone NAT ---
# Required for gaming / P2P / some video conferencing apps
# Cloned from hubbylei/fullconenat-nft during diy-part2.sh
# Provides kmod-nft-fullcone (nftables fullcone expression module)
CONFIG_PACKAGE_kmod-nft-fullcone=y
